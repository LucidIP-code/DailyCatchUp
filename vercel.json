{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "api/options.js", "use": "@vercel/node" },
    { "src": "api/daily-status.js", "use": "@vercel/node" },
    { "src": "api/people.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/options", "dest": "api/options.js" },
    { "src": "/api/daily-status", "dest": "api/daily-status.js" },
    { "src": "/api/people", "dest": "api/people.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
